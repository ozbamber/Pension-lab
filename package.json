{
  "name": "pension-lab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build-dist.js",
    "build:standalone": "node scripts/build-standalone.js",
    "check:standalone": "node scripts/validate-standalone.js",
    "test:engine": "node tests/engine/engine.test.js",
    "test:documents": "node tests/documents/document-extraction.test.js",
    "test:ocr": "node tests/documents/ocr-parser.test.js",
    "test:pension": "node tests/documents/pension-report.test.js && node tests/documents/pension-report-state.test.js && node tests/documents/pension-table-v2.test.js && node tests/documents/pension-routing-safety.test.js",
    "test:browser:ocr": "node tests/browser/ocr-browser.test.js",
    "test:browser:standalone": "npm run build && node tests/browser/standalone-document.test.js",
    "test:browser:smoke": "node tests/browser/browser-smoke.js",
    "test:dataset": "node tests/dataset/dataset.test.js",
    "dataset:validate": "node scripts/dataset/validate-dataset.js",
    "dataset:evaluate": "node scripts/dataset/evaluate-predictions.js",
    "dataset:benchmark:text": "node scripts/dataset/evaluate-parser-text.js",
    "dataset:benchmark:compare": "node scripts/dataset/compare-pension-parser.js",
    "dataset:benchmark:browser": "node tests/dataset/browser-benchmark.test.js",
    "test:core": "npm run test:engine && npm run test:documents && npm run test:ocr && npm run test:pension"
  }
}
